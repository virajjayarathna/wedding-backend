# Environment Variables — Wedding Backend
# Copy this file to .env and fill in your actual values

# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
# Local development (Docker PostgreSQL):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wedding-db?schema=public"

# AWS RDS (Production) — uncomment and fill:
# DATABASE_URL="postgresql://USER:PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/weddingdb?schema=public"

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JWT_SECRET="replace-this-with-a-random-64-char-string-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ─────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────
PORT=4000
NODE_ENV="development"

# Allowed CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://admin.yourdomain.com,https://invite.yourdomain.com"

# ─────────────────────────────────────────
# AWS S3
# ─────────────────────────────────────────
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_S3_BUCKET="wedding-media-bucket"

# CDN base URL (CloudFront or S3 public URL)
AWS_CDN_BASE_URL="https://your-cloudfront-domain.cloudfront.net"

# Presigned URL expiry in seconds (15 minutes)
S3_PRESIGNED_URL_EXPIRES=900

# ─────────────────────────────────────────
# SUPER ADMIN SEED CREDENTIALS
# ─────────────────────────────────────────
SUPER_ADMIN_EMAIL="superadmin@yourdomain.com"
SUPER_ADMIN_PASSWORD="ChangeMe123!"

# ─────────────────────────────────────────
# GUEST INVITE BASE URL
# ─────────────────────────────────────────
# Used by WhatsApp link generator
GUEST_INVITE_BASE_URL="https://invite.yourdomain.com"
# Local dev:
# GUEST_INVITE_BASE_URL="http://localhost:3001"
