generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Admin {
  id                String          @id @default(cuid())
  email             String          @unique
  passwordHash      String
  displayName       String
  phone             String?
  status            AdminStatus     @default(PENDING)
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  wedding           WeddingDetails?

  @@index([status])
}

model WeddingDetails {
  id            String     @id @default(cuid())
  adminId       String     @unique
  brideName     String
  groomName     String
  weddingDate   DateTime
  weddingSlug   String     @unique
  loveStory     String?
  coverPhotoUrl String?
  heroPhotoUrl  String?
  galleryUrls   String[]   @default([])
  venueName     String?
  venueAddress  String?
  venueMapsUrl  String?
  bridePhone    String?
  groomPhone    String?
  brideFatherName String?
  brideFatherPhone String?
  groomFatherName String?
  groomFatherPhone String?
  // Flexible list of RSVP point-of-contact people (name + phone pairs, max 8),
  // configured in the admin "Venue & RSVP" tab. Guests reference entries here
  // by id via Guest.firstRsvpContactId / Guest.secondRsvpContactId.
  rsvpContacts  Json       @default("[]")
  timeline      Json       @default("[]")
  musicUrl      String?
  musicType     MusicType?
  primaryColor  String     @default("#c0b258")
  accentColor   String     @default("#333333")
  fontFamily    String     @default("Playfair Display")
  pdfLogoUrl    String?
  pdfFont       String?
  pdfWeddingDay String?
  pdfStartTime  String?
  pdfEndTime    String?
  pdfCeremonyName String?
  pdfCeremonyTime String?
  rsvpDeadline  DateTime?
  isPublished   Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  guests        Guest[]
  admin         Admin      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([weddingSlug])
}

model Guest {
  id              String         @id @default(cuid())
  weddingId       String
  title           GuestTitle
  firstName       String
  lastName        String
  phone           String?
  maxAttendants   Int            @default(1)
  token           String         @unique @default(cuid())
  rsvpStatus      RsvpStatus     @default(PENDING)
  attendingCount  Int?
  dietaryNotes    String?
  notes           String?
  rsvpSubmittedAt DateTime?
  // References into WeddingDetails.rsvpContacts (by id). Optional — a guest
  // doesn't need to have either contact assigned.
  firstRsvpContactId  String?
  secondRsvpContactId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  wedding         WeddingDetails @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId, rsvpStatus])
  @@index([token])
}

enum AdminStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum MusicType {
  SPOTIFY
  UPLOAD
}

enum GuestTitle {
  MR
  MRS
  MS
  DR
  FAMILY
  MASTER
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINING
  MAYBE
}
