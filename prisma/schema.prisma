generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Admin {
  id                String          @id @default(cuid())
  email             String          @unique
  passwordHash      String
  displayName       String
  phone             String?
  status            AdminStatus     @default(PENDING)
  // Which card template this account's invitation renders. WEDDING keeps the
  // original bride-first wording; HOME_COMING flips the couple to groom-first
  // (see pdf.service.ts and the client's InvitationCard). Set by the superadmin
  // at creation and changeable later from /superadmin/admins/:id.
  ceremonyType      CeremonyType    @default(WEDDING)
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  wedding           WeddingDetails?

  @@index([status])
}

model WeddingDetails {
  id            String     @id @default(cuid())
  adminId       String     @unique
  brideName     String
  groomName     String
  weddingDate   DateTime
  weddingSlug   String     @unique
  loveStory     String?
  coverPhotoUrl String?
  heroPhotoUrl  String?
  // Image used as the og:image on guest invite links — i.e. the thumbnail
  // WhatsApp / Facebook / Viber render when a guest is sent their invitation
  // URL. Uploaded in the admin "Media" tab and normalised to exactly
  // 1200x630 JPEG in the browser before upload, because WhatsApp silently
  // drops link-preview images that are oversized (>~600 KB) or oddly shaped.
  sharePreviewUrl String?
  galleryUrls   String[]   @default([])
  venueName     String?
  venueAddress  String?
  venueMapsUrl  String?
  bridePhone    String?
  groomPhone    String?
  brideFatherName String?
  brideFatherPhone String?
  groomFatherName String?
  groomFatherPhone String?
  // Flexible list of RSVP point-of-contact people (name + phone pairs, max 8),
  // configured in the admin "Venue & RSVP" tab. Guests reference entries here
  // by id via Guest.firstRsvpContactId / Guest.secondRsvpContactId.
  rsvpContacts  Json       @default("[]")
  timeline      Json       @default("[]")
  musicUrl      String?
  musicType     MusicType?
  // ── Theme ────────────────────────────────────────────────────────────
  // Resolved to CSS custom properties by the client app (src/lib/theme.ts).
  // themePreset names a curated palette; the colour columns below are
  // per-field overrides on top of it. All nullable so an untouched wedding
  // falls back to the preset, and an unset preset falls back to Classic Gold.
  // Every colour/font column is nullable and null means "inherit from the
  // preset". primaryColor/accentColor/fontFamily used to be NOT NULL with
  // defaults, but nothing ever rendered them, so the stored values were noise
  // rather than choices — the 20260819180000 migration clears them.
  themePreset   String?
  primaryColor  String?
  accentColor   String?
  bgColor       String?
  surfaceColor  String?
  cardColor     String?
  textColor     String?
  mutedColor    String?
  /// Heading font family.
  fontFamily    String?
  bodyFont      String?
  pdfLogoUrl    String?
  pdfFont       String?
  pdfWeddingDay String?
  pdfStartTime  String?
  pdfEndTime    String?
  pdfCeremonyName String?
  pdfCeremonyTime String?
  rsvpDeadline  DateTime?
  isPublished   Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  guests        Guest[]
  admin         Admin      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([weddingSlug])
}

model Guest {
  id              String         @id @default(cuid())
  weddingId       String
  title           GuestTitle
  isFamily        Boolean        @default(false)
  firstName       String
  lastName        String
  phone           String?
  maxAttendants   Int            @default(1)
  token           String         @unique @default(cuid())
  rsvpStatus      RsvpStatus     @default(PENDING)
  attendingCount  Int?
  dietaryNotes    String?
  notes           String?
  rsvpSubmittedAt DateTime?
  // References into WeddingDetails.rsvpContacts (by id). Optional — a guest
  // doesn't need to have either contact assigned.
  firstRsvpContactId  String?
  secondRsvpContactId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  wedding         WeddingDetails @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId, rsvpStatus])
  @@index([token])
}

enum AdminStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum CeremonyType {
  WEDDING
  HOME_COMING
}

enum MusicType {
  SPOTIFY
  UPLOAD
}

enum GuestTitle {
  MR
  MRS
  MR_AND_MRS
  MS
  DR
  FAMILY
  MASTER
  BRIG
  BRIG_AND_MRS
  MAJ
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINING
  MAYBE
}
